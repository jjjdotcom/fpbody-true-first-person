diff --git a/cl_dll/fpbody_holsters.h b/cl_dll/fpbody_holsters.h
new file mode 100644
index 0000000..c8f634d
--- /dev/null
+++ b/cl_dll/fpbody_holsters.h
@@ -0,0 +1,177 @@
+// fpbody_holsters.h - generated by tools/gmod_anims/holster_table.py
+// Where each carried weapon sits on the body: weapon class names, p_ model,
+// body bone, and the matrix taking the p_ model (frame 0) into that bone's space.
+// keep: bitmask of the p_ model's bones to draw (0 = all).
+
+struct fpholster_def_t
+{
+	const char *weapons;	// space separated class names
+	const char *model;
+	const char *bone;
+	float local[ 3 ][ 4 ];
+	unsigned int keep;
+	int length;		// the p_ model file's header length: picks the LD or HD row
+};
+
+static const fpholster_def_t g_holsterDefs[] =
