+# Builds a small launcher exe: hl.exe -game <FPBODY_GAMEDIR>, with the given icon.
+cmake_minimum_required(VERSION 3.15)
+project(fpbody_launcher C RC)
+set(FPBODY_GAMEDIR "fpbody_asheep" CACHE STRING "mod folder to start")
+set(FPBODY_EXE_NAME "Azure Sheep True First Person" CACHE STRING "exe name")
+set(FPBODY_ICON "" CACHE FILEPATH "icon (.ico)")
+if(FPBODY_ICON AND EXISTS "${FPBODY_ICON}")
+  configure_file("${FPBODY_ICON}" "${CMAKE_CURRENT_SOURCE_DIR}/icon.ico" COPYONLY)
+  set(RES launcher.rc)
+endif()
+add_executable(fpbody_launcher WIN32 launcher.c ${RES})
+target_compile_definitions(fpbody_launcher PRIVATE FPBODY_GAMEDIR="${FPBODY_GAMEDIR}" _CRT_SECURE_NO_WARNINGS)
+set_target_properties(fpbody_launcher PROPERTIES OUTPUT_NAME "${FPBODY_EXE_NAME}" MSVC_RUNTIME_LIBRARY "MultiThreaded")
diff --git a/fpbody_launcher/launcher.c b/fpbody_launcher/launcher.c
new file mode 100644
index 0000000..bd48a4b
--- /dev/null
+++ b/fpbody_launcher/launcher.c
@@ -0,0 +1,39 @@
+/* fpbody_launcher: starts Half-Life with a mod (the gamedir is set at build time).
+   Put the exe in the Half-Life folder, next to hl.exe; extra arguments are passed on. */
+#include <windows.h>
+#include <stdio.h>
+#include <string.h>
+
+#ifndef FPBODY_GAMEDIR
+#define FPBODY_GAMEDIR "fpbody_asheep"
+#endif
+
+int WINAPI WinMain( HINSTANCE inst, HINSTANCE prev, LPSTR args, int show )
+{
+	char dir[ MAX_PATH ], exe[ MAX_PATH ], cmd[ 4096 ];
+	char *slash;
+	STARTUPINFOA si;
+	PROCESS_INFORMATION pi;
+
+	GetModuleFileNameA( NULL, dir, sizeof( dir ) );
+	slash = strrchr( dir, '\\' );
+	if( slash )
+		*slash = 0;
+	_snprintf( exe, sizeof( exe ), "%s\\hl.exe", dir );
+	if( GetFileAttributesA( exe ) == INVALID_FILE_ATTRIBUTES )
+	{
+		MessageBoxA( NULL, "hl.exe was not found next to this launcher.\nPut it in your Half-Life folder.", "True First Person", MB_ICONERROR );
+		return 1;
+	}
+	_snprintf( cmd, sizeof( cmd ), "\"%s\" -game " FPBODY_GAMEDIR " %s", exe, args ? args : "" );
+	ZeroMemory( &si, sizeof( si ) );
+	si.cb = sizeof( si );
+	if( !CreateProcessA( exe, cmd, NULL, NULL, FALSE, 0, NULL, dir, &si, &pi ) )
+	{
+		MessageBoxA( NULL, "Could not start hl.exe.", "True First Person", MB_ICONERROR );
+		return 1;
+	}
+	CloseHandle( pi.hThread );
+	CloseHandle( pi.hProcess );
+	return 0;
+}
