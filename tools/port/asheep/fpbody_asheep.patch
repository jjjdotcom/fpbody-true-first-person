+static const char *OverlayName( void )
+{
+	if ( g_ovSeq < 0 || !g_playerHdr || g_ovSeq >= g_playerHdr->numseq )
+		return "(none)";
+	const mstudioseqdesc_t *sd = (const mstudioseqdesc_t *)( (const byte *)g_playerHdr + g_playerHdr->seqindex ) + g_ovSeq;
+	return sd->label;
+}
