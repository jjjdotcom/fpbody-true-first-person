+// ---------------------------------------------------------------------------
+// Holsters
+// ---------------------------------------------------------------------------
+
+#define NUM_HOLSTER_DEFS ( (int)( sizeof( g_holsterDefs ) / sizeof( g_holsterDefs[ 0 ] ) ) )
+#define NUM_HOLSTER_DEFS_MAX 256
+
+// does a space separated list of class names contain this one
+static bool NameInList( const char *list, const char *name )
+{
+	size_t len = strlen( name );
+	const char *p = list;
+	while ( *p )
+	{
+		while ( *p == ' ' ) p++;
+		const char *e = p;
+		while ( *e && *e != ' ' ) e++;
+		if ( (size_t)( e - p ) == len && !strnicmp( p, name, len ) )
+			return true;
+		p = e;
+	}
+	return false;
+}
+
+static bool OwnsWeaponNamed( const char *list )
+{
+	unsigned long long bits = (unsigned long long)gHUD.m_iWeaponBits;
+	if ( sizeof( gHUD.m_iWeaponBits ) < 8 )
+		bits &= 0xffffffffULL;
+	for ( int id = 1; id < MAX_WEAPONS && id < 64; id++ )
+	{
+		if ( !( ( bits >> id ) & 1ULL ) )
+			continue;
+		WEAPON *w = gWR.GetWeapon( id );
+		if ( w && w->szName[ 0 ] && NameInList( list, w->szName ) )
+			return true;
+	}
+	return false;
+}
+
+// ---------------------------------------------------------------------------
+// fp_holster: move / turn where a carried weapon sits on the body, per weapon
+// (by its p_ model), saved in <game>/fpbody_holsters.cfg. The moves are in the
+// body's own directions (forward, left, up) and the turns about them, whatever
+// bone the weapon hangs from; they follow the body as it moves.
+// ---------------------------------------------------------------------------
+struct holsterofs_t { char model[ 32 ]; float v[ 6 ]; };
+static holsterofs_t g_holsterOfs[ 64 ];
+static int g_numHolsterOfs;
+static bool g_holsterCfgRun;
+static const studiohdr_t *g_holsterLastHdr;	// the body the holsters were last placed on
+static int g_holsterShown[ NUM_HOLSTER_DEFS_MAX ];
+static int g_numHolsterShown;
+
+// "models/p_shotgun.mdl" -> "p_shotgun"
+static void HolsterShortName( const char *path, char *out, int size )
+{
+	const char *n = strrchr( path, '/' );
+	n = n ? n + 1 : path;
+	int i = 0;
+	for ( ; n[ i ] && n[ i ] != '.' && i < size - 1; i++ )
+		out[ i ] = (char)tolower( (unsigned char)n[ i ] );
+	out[ i ] = 0;
+}
+
+static holsterofs_t *HolsterOfsFor( const char *name, bool create )
+{
+	for ( int i = 0; i < g_numHolsterOfs; i++ )
+		if ( !stricmp( g_holsterOfs[ i ].model, name ) )
+			return &g_holsterOfs[ i ];
+	if ( !create || g_numHolsterOfs >= (int)( sizeof( g_holsterOfs ) / sizeof( g_holsterOfs[ 0 ] ) ) )
+		return NULL;
+	holsterofs_t *h = &g_holsterOfs[ g_numHolsterOfs++ ];
+	memset( h, 0, sizeof( *h ) );
+	strncpy( h->model, name, sizeof( h->model ) - 1 );
+	return h;
+}
+
+// what the player typed -> the p_ model name of a holster: "shotgun",
+// "p_shotgun" or "weapon_shotgun"
+static bool HolsterResolve( const char *arg, char *out, int size )
+{
+	char want[ 48 ];
+	snprintf( want, sizeof( want ), "%s", arg );
+	for ( char *c = want; *c; c++ )
+		*c = (char)tolower( (unsigned char)*c );
+	for ( int i = 0; i < NUM_HOLSTER_DEFS; i++ )
+	{
+		char name[ 32 ];
+		HolsterShortName( g_holsterDefs[ i ].model, name, sizeof( name ) );
+		if ( !stricmp( want, name ) || !stricmp( want, name + 2 ) || NameInList( g_holsterDefs[ i ].weapons, want ) )
+		{
+			snprintf( out, size, "%s", name );
+			return true;
+		}
+		char wpn[ 48 ];
+		snprintf( wpn, sizeof( wpn ), "weapon_%s", want );
+		if ( NameInList( g_holsterDefs[ i ].weapons, wpn ) )
+		{
+			snprintf( out, size, "%s", name );
+			return true;
+		}
+	}
+	return false;
+}
+
+static void HolsterSave( void )
+{
+	char path[ 256 ];
+	snprintf( path, sizeof( path ), "%s/fpbody_holsters.cfg", gEngfuncs.pfnGetGameDirectory() );
+	FILE *fp = fopen( path, "w" );
+	if ( !fp )
+	{
+		gEngfuncs.Con_Printf( "fp_holster: couldn't write %s\n", path );
+		return;
+	}
+	fprintf( fp, "// fpbody holster tuning (fp_holster): forward left up pitch yaw roll\n" );
+	for ( int i = 0; i < g_numHolsterOfs; i++ )
+	{
+		const float *v = g_holsterOfs[ i ].v;
+		fprintf( fp, "fp_holster_set %s %g %g %g %g %g %g\n", g_holsterOfs[ i ].model, v[ 0 ], v[ 1 ], v[ 2 ], v[ 3 ], v[ 4 ], v[ 5 ] );
+	}
+	fclose( fp );
+}
+
+static void FPBody_HolsterSetCmd( void )
+{
+	if ( gEngfuncs.Cmd_Argc() < 5 )
+		return;
+	holsterofs_t *h = HolsterOfsFor( gEngfuncs.Cmd_Argv( 1 ), true );
+	if ( !h )
+		return;
+	for ( int i = 0; i < 6; i++ )
+		h->v[ i ] = ( i + 2 < gEngfuncs.Cmd_Argc() ) ? (float)atof( gEngfuncs.Cmd_Argv( i + 2 ) ) : 0.0f;
+}
+
+static void FPBody_HolsterCmd( void )
+{
+	int argc = gEngfuncs.Cmd_Argc();
+	if ( argc < 2 )
+	{
+		gEngfuncs.Con_Printf( "usage: fp_holster <weapon> <forward> <left> <up> [pitch yaw roll]   (or: fp_holster <weapon> reset)\n"
+							  "  <weapon>: shotgun, 9mmar, crossbow, rpg, gauss, egon, crowbar, 357, 9mmhandgun, ... (or weapon_shotgun / p_shotgun)\n"
+							  "  forward / left / up in units (negative = back / right / down), the turns in degrees.\n"
+							  "  Each command sets the full values; they save to fpbody_holsters.cfg.\n" );
+		if ( !g_numHolsterShown )
+			gEngfuncs.Con_Printf( "Nothing is on your body right now.\n" );
+		else
+			gEngfuncs.Con_Printf( "On your body now:\n" );
+		char seen[ 16 ][ 32 ];
+		int ns = 0;
+		for ( int k = 0; k < g_numHolsterShown; k++ )
+		{
+			char name[ 32 ];
+			HolsterShortName( g_holsterDefs[ g_holsterShown[ k ] ].model, name, sizeof( name ) );
+			bool dup = false;
+			for ( int j = 0; j < ns; j++ )
+				if ( !strcmp( seen[ j ], name ) )
+					dup = true;
+			if ( dup || ns >= 16 )
+				continue;
+			strcpy( seen[ ns++ ], name );
+			const holsterofs_t *h = HolsterOfsFor( name, false );
+			float z[ 6 ] = { 0, 0, 0, 0, 0, 0 };
+			const float *v = h ? h->v : z;
+			gEngfuncs.Con_Printf( "  fp_holster %s %g %g %g %g %g %g\n", name + 2, v[ 0 ], v[ 1 ], v[ 2 ], v[ 3 ], v[ 4 ], v[ 5 ] );
+		}
+		return;
+	}
+	char name[ 32 ];
+	if ( !HolsterResolve( gEngfuncs.Cmd_Argv( 1 ), name, sizeof( name ) ) )
+	{
+		gEngfuncs.Con_Printf( "fp_holster: no holster for \"%s\" (type fp_holster to see what's on your body)\n", gEngfuncs.Cmd_Argv( 1 ) );
+		return;
+	}
+	if ( argc == 2 )
+	{
+		const holsterofs_t *h = HolsterOfsFor( name, false );
+		float z[ 6 ] = { 0, 0, 0, 0, 0, 0 };
+		const float *v = h ? h->v : z;
+		gEngfuncs.Con_Printf( "fp_holster %s %g %g %g %g %g %g\n", name + 2, v[ 0 ], v[ 1 ], v[ 2 ], v[ 3 ], v[ 4 ], v[ 5 ] );
+		return;
+	}
+	holsterofs_t *h = HolsterOfsFor( name, true );
+	if ( !h )
+		return;
+	if ( !stricmp( gEngfuncs.Cmd_Argv( 2 ), "reset" ) )
+		memset( h->v, 0, sizeof( h->v ) );
+	else
+		for ( int i = 0; i < 6; i++ )
+			h->v[ i ] = ( i + 2 < argc ) ? (float)atof( gEngfuncs.Cmd_Argv( i + 2 ) ) : 0.0f;
+	HolsterSave();
+	gEngfuncs.Con_Printf( "fp_holster %s %g %g %g %g %g %g\n", name + 2, h->v[ 0 ], h->v[ 1 ], h->v[ 2 ], h->v[ 3 ], h->v[ 4 ], h->v[ 5 ] );
+}
+
+// rest-pose rotation of every bone in the body's frame (x forward, y left, z up)
+static void HolsterRestRot( const studiohdr_t *hdr, int bone, float out[ 3 ][ 3 ] )
+{
+	const mstudiobone_t *bones = (const mstudiobone_t *)( (const byte *)hdr + hdr->boneindex );
+	float m[ 3 ][ 3 ] = { { 1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 } };
+	int chain[ MAXSTUDIOBONES ], n = 0;
+	for ( int b = bone; b >= 0 && n < MAXSTUDIOBONES; b = bones[ b ].parent )
+		chain[ n++ ] = b;
+	for ( int k = n - 1; k >= 0; k-- )
+	{
+		const mstudiobone_t *b = &bones[ chain[ k ] ];
+		float ang[ 3 ] = { b->value[ 3 ], b->value[ 4 ], b->value[ 5 ] }, q[ 4 ], lm[ 3 ][ 4 ], r[ 3 ][ 3 ];
+		AngleQuaternion( ang, q );
+		QuaternionMatrix( q, lm );
+		for ( int i = 0; i < 3; i++ )
+			for ( int j = 0; j < 3; j++ )
+				r[ i ][ j ] = m[ i ][ 0 ] * lm[ 0 ][ j ] + m[ i ][ 1 ] * lm[ 1 ][ j ] + m[ i ][ 2 ] * lm[ 2 ][ j ];
+		memcpy( m, r, sizeof( m ) );
+	}
+	memcpy( out, m, sizeof( m ) );
+}
+
+// apply a weapon's fp_holster values to a holster on bone 'anchor'
+static void HolsterApplyOfs( const studiohdr_t *hdr, const fpholster_def_t *d, fpholster_t *h )
+{
+	h->hasRot = 0;
+	char name[ 32 ];
+	HolsterShortName( d->model, name, sizeof( name ) );
+	const holsterofs_t *o = HolsterOfsFor( name, false );
+	if ( !o )
+		return;
+	const float *v = o->v;
+	if ( !v[ 0 ] && !v[ 1 ] && !v[ 2 ] && !v[ 3 ] && !v[ 4 ] && !v[ 5 ] )
+		return;
+	float B[ 3 ][ 3 ];
+	HolsterRestRot( hdr, h->anchor, B );		// bone -> body
+	// the move, body frame -> bone frame (B transposed)
+	for ( int c = 0; c < 3; c++ )
+		h->shift[ c ] += B[ 0 ][ c ] * v[ 0 ] + B[ 1 ][ c ] * v[ 1 ] + B[ 2 ][ c ] * v[ 2 ];
+	if ( !v[ 3 ] && !v[ 4 ] && !v[ 5 ] )
+		return;
+	// the turn in the body frame: yaw about up, pitch about left (+ = front up), roll about forward
+	float p = -v[ 3 ] * 0.0174532925f, y = v[ 4 ] * 0.0174532925f, r = v[ 5 ] * 0.0174532925f;
+	float Rz[ 3 ][ 3 ] = { { cosf( y ), -sinf( y ), 0 }, { sinf( y ), cosf( y ), 0 }, { 0, 0, 1 } };
+	float Ry[ 3 ][ 3 ] = { { cosf( p ), 0, sinf( p ) }, { 0, 1, 0 }, { -sinf( p ), 0, cosf( p ) } };
+	float Rx[ 3 ][ 3 ] = { { 1, 0, 0 }, { 0, cosf( r ), -sinf( r ) }, { 0, sinf( r ), cosf( r ) } };
+	float T[ 3 ][ 3 ], M[ 3 ][ 3 ], BM[ 3 ][ 3 ];
+	for ( int i = 0; i < 3; i++ )
+		for ( int j = 0; j < 3; j++ )
+			T[ i ][ j ] = Ry[ i ][ 0 ] * Rx[ 0 ][ j ] + Ry[ i ][ 1 ] * Rx[ 1 ][ j ] + Ry[ i ][ 2 ] * Rx[ 2 ][ j ];
+	for ( int i = 0; i < 3; i++ )
+		for ( int j = 0; j < 3; j++ )
+			M[ i ][ j ] = Rz[ i ][ 0 ] * T[ 0 ][ j ] + Rz[ i ][ 1 ] * T[ 1 ][ j ] + Rz[ i ][ 2 ] * T[ 2 ][ j ];
+	// in bone space: B^T M B
+	for ( int i = 0; i < 3; i++ )
+		for ( int j = 0; j < 3; j++ )
+			BM[ i ][ j ] = M[ i ][ 0 ] * B[ 0 ][ j ] + M[ i ][ 1 ] * B[ 1 ][ j ] + M[ i ][ 2 ] * B[ 2 ][ j ];
+	for ( int i = 0; i < 3; i++ )
+		for ( int j = 0; j < 3; j++ )
+			h->rot[ i ][ j ] = B[ 0 ][ i ] * BM[ 0 ][ j ] + B[ 1 ][ i ] * BM[ 1 ][ j ] + B[ 2 ][ i ] * BM[ 2 ][ j ];
+	h->hasRot = 1;
+}
+
+int FPBody_GetHolsters( int playerNumber, int weaponmodel, void *playerStudioHdr, fpholster_t *out, int max )
+{
+	static int modelState[ NUM_HOLSTER_DEFS ];
+	static int anchorOf[ NUM_HOLSTER_DEFS ];
+	static const studiohdr_t *anchorHdr;
+
+	if ( !cl_fpbody_holster || cl_fpbody_holster->value == 0.0f || !FPBody_Active() || !playerStudioHdr )
+		return 0;
+	cl_entity_t *local = gEngfuncs.GetLocalPlayer();
+	if ( !local || playerNumber != local->index )
+		return 0;
+
+	if ( !g_holsterCfgRun )
+	{
+		g_holsterCfgRun = true;
+		gEngfuncs.pfnClientCmd( "exec fpbody_holsters.cfg\n" );
+	}
+	const studiohdr_t *hdr = (const studiohdr_t *)playerStudioHdr;
+	g_holsterLastHdr = hdr;
+	g_numHolsterShown = 0;
+	if ( hdr != anchorHdr )
+	{
+		anchorHdr = hdr;
+		const mstudiobone_t *pbones = (const mstudiobone_t *)( (const byte *)hdr + hdr->boneindex );
+		for ( int i = 0; i < NUM_HOLSTER_DEFS; i++ )
+		{
+			anchorOf[ i ] = -1;
+			for ( int b = 0; b < hdr->numbones && b < MAXSTUDIOBONES; b++ )
+				if ( !stricmp( pbones[ b ].name, g_holsterDefs[ i ].bone ) )
+				{
+					anchorOf[ i ] = b;
+					break;
+				}
+		}
+	}
+
+	const char *held = NULL;
+	if ( weaponmodel )
+	{
+		struct model_s *wm = IEngineStudio.GetModelByIndex( weaponmodel );
+		if ( wm )
+			held = wm->name;
+	}
+
+	// Each weapon has a row per model variant (LD / HD, picked by the game's
+	// HD models setting); the row whose recorded header length matches the
+	// model the engine loaded wins. If none matches (a model from somewhere
+	// else), the first row of that weapon and bone is used.
+	struct model_s *loaded[ NUM_HOLSTER_DEFS ];
+	bool lenOk[ NUM_HOLSTER_DEFS ];
+	for ( int i = 0; i < NUM_HOLSTER_DEFS; i++ )
+	{
+		const fpholster_def_t *d = &g_holsterDefs[ i ];
+		loaded[ i ] = NULL;
+		lenOk[ i ] = false;
+		if ( anchorOf[ i ] < 0 || ( held && !stricmp( held, d->model ) ) || !OwnsWeaponNamed( d->weapons ) )
+			continue;
+		loaded[ i ] = FPBody_TryModel( d->model, modelState[ i ] );
+		if ( !loaded[ i ] )
+			continue;
+		const studiohdr_t *mh = (const studiohdr_t *)IEngineStudio.Mod_Extradata( loaded[ i ] );
+		lenOk[ i ] = mh && mh->length == d->length;
+	}
+
+	// the Half-Life: Source style bodies get the guns pulled in to touch them
+	bool hlsBody = !strnicmp( hdr->name, "fpbody_hls", 10 ) || strstr( hdr->name, "/fpbody_hls" ) != NULL;
+	int n = 0;
+	for ( int i = 0; i < NUM_HOLSTER_DEFS && n < max; i++ )
+	{
+		const fpholster_def_t *d = &g_holsterDefs[ i ];
+		struct model_s *m = loaded[ i ];
+		if ( !m )
+			continue;
+		if ( !lenOk[ i ] )
+		{
+			bool other = false, first = true;
+			for ( int j = 0; j < NUM_HOLSTER_DEFS; j++ )
+			{
+				const fpholster_def_t *e = &g_holsterDefs[ j ];
+				if ( j == i || strcmp( e->weapons, d->weapons ) || strcmp( e->bone, d->bone ) )
+					continue;
+				if ( lenOk[ j ] )
+					other = true;
+				if ( j < i && loaded[ j ] )
+					first = false;
+			}
+			if ( other || !first )
+				continue;
+		}
+		out[ n ].model = m;
+		out[ n ].anchor = anchorOf[ i ];
+		out[ n ].local = d->local;
+		out[ n ].keep = d->keep;
+		out[ n ].shift[ 0 ] = out[ n ].shift[ 1 ] = out[ n ].shift[ 2 ] = 0.0f;
+		if ( hlsBody && lenOk[ i ] )
+			for ( int k = 0; k < (int)( sizeof( g_holsterShiftHLS ) / sizeof( g_holsterShiftHLS[ 0 ] ) ); k++ )
+				if ( g_holsterShiftHLS[ k ].length == d->length && !stricmp( g_holsterShiftHLS[ k ].bone, d->bone ) )
+				{
+					for ( int c = 0; c < 3; c++ )
+						out[ n ].shift[ c ] = g_holsterShiftHLS[ k ].shift[ c ];
+					break;
+				}
+		HolsterApplyOfs( hdr, d, &out[ n ] );
+		if ( g_numHolsterShown < NUM_HOLSTER_DEFS_MAX )
+			g_holsterShown[ g_numHolsterShown++ ] = i;
+		n++;
+	}
+	return n;
+}
+
+void FPBody_HolsterMatrix( const fpholster_t *h, const float ( *playerLight )[ 3 ][ 4 ], float ( *out )[ 4 ] )
+{
+	if ( h->anchor < 0 )	// placed in the world already (the fp_helmet prop)
+	{
+		memcpy( out, h->local, sizeof( float ) * 12 );
+		return;
+	}
+	const float ( *A )[ 4 ] = playerLight[ h->anchor ];
+	float Lr[ 3 ][ 4 ];
+	const float ( *L )[ 4 ] = h->local;
+	if ( h->hasRot )		// fp_holster's turn, about the weapon's own origin
+	{
+		for ( int r = 0; r < 3; r++ )
+		{
+			for ( int c = 0; c < 3; c++ )
+				Lr[ r ][ c ] = h->rot[ r ][ 0 ] * L[ 0 ][ c ] + h->rot[ r ][ 1 ] * L[ 1 ][ c ] + h->rot[ r ][ 2 ] * L[ 2 ][ c ];
+			Lr[ r ][ 3 ] = L[ r ][ 3 ];
+		}
+		L = Lr;
+	}
+	for ( int r = 0; r < 3; r++ )
+	{
+		for ( int c = 0; c < 3; c++ )
+			out[ r ][ c ] = A[ r ][ 0 ] * L[ 0 ][ c ] + A[ r ][ 1 ] * L[ 1 ][ c ] + A[ r ][ 2 ] * L[ 2 ][ c ];
+		out[ r ][ 3 ] = A[ r ][ 0 ] * ( L[ 0 ][ 3 ] + h->shift[ 0 ] ) + A[ r ][ 1 ] * ( L[ 1 ][ 3 ] + h->shift[ 1 ] ) +
+						A[ r ][ 2 ] * ( L[ 2 ][ 3 ] + h->shift[ 2 ] ) + A[ r ][ 3 ];
+	}
+}
+
+void FPBody_HolsterHideBones( const fpholster_t *h, void *studiohdr, float ( *bonetransform )[ 3 ][ 4 ],
+	float ( *lighttransform )[ 3 ][ 4 ] )
+{
+	if ( !h->keep || !studiohdr )
+		return;
+	const studiohdr_t *hdr = (const studiohdr_t *)studiohdr;
+	for ( int b = 0; b < hdr->numbones && b < 32; b++ )
+	{
+		if ( h->keep & ( 1u << b ) )
+			continue;
+		float pivot[ 3 ] = { bonetransform[ b ][ 0 ][ 3 ], bonetransform[ b ][ 1 ][ 3 ], bonetransform[ b ][ 2 ][ 3 ] };
+		CollapseBone( bonetransform, b, pivot );
+		if ( lighttransform != bonetransform )
+		{
+			float lp[ 3 ] = { lighttransform[ b ][ 0 ][ 3 ], lighttransform[ b ][ 1 ][ 3 ], lighttransform[ b ][ 2 ][ 3 ] };
+			CollapseBone( lighttransform, b, lp );
+		}
+	}
+}
diff --git a/cl_dll/fpbody.h b/cl_dll/fpbody.h
new file mode 100644
index 0000000..73cdbd7
--- /dev/null
+++ b/cl_dll/fpbody.h
@@ -0,0 +1,84 @@
+// fpbody.h - "True first person" / body awareness for Half-Life.
+//
+// The engine draws the local player's third-person model (player.mdl and the
+// p_ weapon in its hands), the head is collapsed so it doesn't block the view,
+// and the camera is placed at the head bone of that animated body.
+
+#ifndef FPBODY_H
+#define FPBODY_H
+
+struct ref_params_s;
+struct cl_entity_s;
+
+// Registers the cl_fpbody* cvars. Called from V_Init().
+void FPBody_Init( void );
+
+// Called at the start of every V_CalcRefdef() with the engine's view params,
+// so the mod knows whether it should be active this frame (intermission,
+// trigger_camera views, death, etc. turn it off).
+void FPBody_BeginFrame( struct ref_params_s *pparams );
+
+// True when the body should be drawn and the camera put in its head.
+// Exported to the engine through CL_IsThirdPerson().
+int FPBody_Active( void );
+
+// Called from the studio renderer right after the local player's bones are
+// built. Records where the head is and collapses the head so it's invisible.
+void FPBody_ProcessPlayerBones( int playerNumber, struct cl_entity_s *ent, void *studiohdr,
+	float ( *bonetransform )[ 3 ][ 4 ], float ( *lighttransform )[ 3 ][ 4 ], int weaponmodel );
+
+// Unarmed: the gait sequence (walk / run) animates the whole body, so the
+// arms swing. Set before the local player's bones are set up, read by the
+// gait merge in StudioSetupBones.
+void FPBody_SetWholeBodyGait( int playerNumber, int weaponmodel, int overlay );
+int FPBody_WholeBodyGait( void );
+
+// Weapons carried on the body (holsters): drawn by the studio renderer right
+// after the local player, one entry per weapon we own but aren't holding.
+#define FPBODY_MAX_HOLSTERS 32
+struct fpholster_t
+{
+	struct model_s *model;		// the weapon's p_ model
+	int anchor;					// player bone it hangs on
+	const float ( *local )[ 4 ];	// p_ model space -> anchor bone space (3x4)
+	unsigned int keep;			// bones of the p_ model to draw (0 = all)
+	float shift[ 3 ];			// extra move in anchor-bone space (onto a slimmer body)
+	float rot[ 3 ][ 3 ];		// fp_holster turn, in anchor-bone space
+	int hasRot;
+};
+int FPBody_GetHolsters( int playerNumber, int weaponmodel, void *playerStudioHdr, fpholster_t *out, int max );
+// rotationmatrix for StudioSetupBones = anchor bone (from the player's cached light transforms) * local
